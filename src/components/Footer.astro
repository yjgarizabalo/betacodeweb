---
import { SITE, CONTACT, SOCIAL, NAV_LINKS, WHATSAPP_URL, LOCATION } from '@/consts';
import Icon from '@components/Icon.astro';
import BrandIcon from '@components/BrandIcon.astro';

const year = new Date().getFullYear();

const socials = [
	{ name: 'GitHub', brand: 'github', href: SOCIAL.github },
	{ name: 'Instagram', brand: 'instagram', href: SOCIAL.instagram },
	{ name: 'Facebook', brand: 'facebook', href: SOCIAL.facebook },
	{ name: 'LinkedIn', brand: 'linkedin', href: SOCIAL.linkedin },
	{ name: 'X', brand: 'x', href: SOCIAL.x },
];

const services = [
	{ label: 'Desarrollo web', href: '/#servicios' },
	{ label: 'Posicionamiento SEO', href: '/#servicios' },
	{ label: 'Desarrollo de software', href: '/#servicios' },
];
---

<footer class="band-dark">
	<div class="h-1 w-full bg-spectrum" aria-hidden="true"></div>

	<div class="shell py-16 lg:py-20">
		<div class="grid gap-12 lg:grid-cols-12">
			<div class="lg:col-span-4">
				<a href="/" class="inline-flex items-center gap-2.5 text-[1.0625rem] font-semibold tracking-tight text-white">
					<img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7" />
					{SITE.name}
				</a>
				<p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed text-ink-200/80">
					Desarrollo web, posicionamiento SEO y software a medida en {LOCATION.city}, {LOCATION.country}.
				</p>
				<ul class="mt-7 flex gap-2">
					{
						socials.map((social) => (
							<li>
								<a
									href={social.href}
									target="_blank"
									rel="noopener"
									aria-label={social.name}
									class="flex h-10 w-10 items-center justify-center rounded-md text-ink-200/70 transition-colors hover:bg-white/10 hover:text-white"
								>
									<BrandIcon name={social.brand} class="h-[18px] w-[18px]" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-2">
				<h2 class="text-[0.8125rem] font-semibold uppercase tracking-[0.08em] text-white">Navegación</h2>
				<ul class="mt-5 space-y-3">
					{
						NAV_LINKS.map((link) => (
							<li>
								<a href={link.href} class="text-[0.9375rem] text-ink-200/80 transition-colors hover:text-white">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-3">
				<h2 class="text-[0.8125rem] font-semibold uppercase tracking-[0.08em] text-white">Servicios</h2>
				<ul class="mt-5 space-y-3">
					{
						services.map((service) => (
							<li>
								<a href={service.href} class="text-[0.9375rem] text-ink-200/80 transition-colors hover:text-white">
									{service.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-3">
				<h2 class="text-[0.8125rem] font-semibold uppercase tracking-[0.08em] text-white">Contacto</h2>
				<ul class="mt-5 space-y-3">
					<li>
						<a
							href={WHATSAPP_URL}
							target="_blank"
							rel="noopener"
							class="inline-flex items-center gap-2.5 text-[0.9375rem] text-ink-200/80 transition-colors hover:text-white"
						>
							<BrandIcon name="whatsapp" class="h-4 w-4 flex-none" />
							{CONTACT.whatsappDisplay}
						</a>
					</li>
					<li>
						<a
							href={`mailto:${CONTACT.email}`}
							class="inline-flex items-center gap-2.5 text-[0.9375rem] text-ink-200/80 transition-colors hover:text-white"
						>
							<Icon name="envelope" class="h-4 w-4 flex-none" />
							{CONTACT.email}
						</a>
					</li>
					<li class="inline-flex items-center gap-2.5 text-[0.9375rem] text-ink-200/80">
						<Icon name="map-pin" class="h-4 w-4 flex-none" />
						{LOCATION.city}, {LOCATION.country}
					</li>
				</ul>
			</div>
		</div>

		<p class="mt-14 border-t border-white/10 pt-7 text-[0.875rem] text-ink-200/60">
			© {year} {SITE.name}. Todos los derechos reservados.
		</p>
	</div>
</footer>

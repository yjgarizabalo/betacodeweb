---
import { Image } from 'astro:assets';
// Imagen cuadrada (1500×1500): funciona bien en la columna lateral.
import aboutImage from '@assets/hero.jpg';
import Icon from '@components/Icon.astro';

const highlights = [
	{
		title: 'Automatización empresarial sin límites',
		description: 'Conectamos tus procesos para que el trabajo repetitivo deje de consumir tu tiempo.',
	},
	{
		title: 'Plataformas de gestión de recursos',
		description: 'Centraliza la información de tu operación y toma decisiones con datos reales.',
	},
	{
		title: 'Adaptables a cualquier actividad económica',
		description: 'Diseñamos soluciones que encajan con tu sector, sin importar su tamaño.',
	},
];
---

<section id="nosotros" class="section band-tint">
	<div class="shell grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
		<div data-reveal>
			<div class="rule-spectrum" aria-hidden="true" data-reveal="bar"></div>
			<p class="eyebrow mt-6">Nosotros</p>
			<h2 class="mt-4 text-h2">Invertimos en el potencial del mundo laboral</h2>
			<p class="lead mt-5">
				Proporcionamos de manera eficiente experiencias de servicio sobresalientes,
				evitando la complejidad asociada a las soluciones tradicionales de gestión de
				tecnologías de la información.
			</p>

			<ul class="mt-10 space-y-7">
				{
					highlights.map((item) => (
						<li class="flex gap-4">
							<span class="icon-tile h-9 w-9 flex-none">
								<Icon name="check" class="h-[1.125rem] w-[1.125rem]" />
							</span>
							<div>
								<h3 class="text-[1.0625rem] font-semibold text-fg">{item.title}</h3>
								<p class="mt-1.5 text-[0.9375rem] leading-relaxed text-fg-muted">{item.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>

		<!-- El encuadre se asienta mientras la imagen sube: el recorte lo
		     contiene el contenedor, no la propia imagen. -->
		<div class="overflow-hidden rounded-2xl border border-line shadow-card" data-reveal="right" data-frame>
			<Image
				src={aboutImage}
				alt="Equipo de Betacode colaborando en soluciones tecnológicas"
				widths={[600, 900, 1200]}
				sizes="(max-width: 1024px) 92vw, 432px"
				loading="lazy"
				quality={62}
				data-media-settle
				class="aspect-[4/3] w-full object-cover"
			/>
		</div>
	</div>
</section>

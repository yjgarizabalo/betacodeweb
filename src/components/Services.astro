---
import { WHATSAPP_URL } from '@/consts';
import Icon from '@components/Icon.astro';

const services = [
	{
		icon: 'code-bracket',
		title: 'Desarrollo web',
		description:
			'Creamos tu sitio web con originalidad, contenido atractivo y un diseño adaptable, hecho a la medida de tu marca.',
		points: ['Diseño propio, sin plantillas', 'Adaptable a cualquier pantalla', 'Listo para crecer contigo'],
	},
	{
		icon: 'magnifying-glass',
		title: 'Posicionamiento SEO',
		description:
			'Optimizamos tu sitio para potenciar tu visibilidad en Google y en los motores de búsqueda con IA.',
		points: ['Estructura optimizada', 'Datos estructurados', 'Rendimiento y Core Web Vitals'],
	},
	{
		icon: 'cpu-chip',
		title: 'Desarrollo de software',
		description:
			'Transformamos ideas en soluciones digitales innovadoras con nuestra experiencia en desarrollo a medida.',
		points: ['Automatización de procesos', 'Integraciones a medida', 'Soporte y evolución'],
	},
];
---

<section id="servicios" class="section bg-surface">
	<div class="shell">
		<div class="max-w-3xl">
			<div class="rule-spectrum" aria-hidden="true"></div>
			<p class="eyebrow mt-6">Nuestros servicios</p>
			<h2 class="mt-4 text-h2">Destaca sobre tus competidores y expande el alcance de tu empresa</h2>
			<p class="lead mt-5">
				Con estrategias de automatización eficientes, te guiamos para sobresalir en tu
				sector y llegar de forma impactante a tu audiencia objetivo.
			</p>
		</div>

		<div class="mt-14 grid gap-6 lg:grid-cols-3">
			{
				services.map((service) => (
					<article class="card card-hover flex flex-col p-8">
						<span class="icon-tile">
							<Icon name={service.icon} class="h-[1.375rem] w-[1.375rem]" />
						</span>
						<h3 class="mt-6 text-h3">{service.title}</h3>
						<p class="mt-3 text-[0.9375rem] leading-relaxed text-fg-muted">{service.description}</p>
						<ul class="mt-6 flex-1 space-y-2.5 border-t border-line pt-6">
							{service.points.map((point) => (
								<li class="flex items-start gap-2.5 text-[0.9375rem] text-fg-muted">
									<Icon name="check" class="mt-1 h-4 w-4 flex-none text-brand-600" />
									{point}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

		<div class="mt-12">
			<a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-link">
				Cotizar tu proyecto
				<Icon name="arrow-right" class="h-4 w-4" />
			</a>
		</div>
	</div>
</section>

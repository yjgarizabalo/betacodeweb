---
import { FAQ_ITEMS, WHATSAPP_URL } from '@/consts';
import Icon from '@components/Icon.astro';
---

<section id="faq" class="section bg-surface">
	<div class="shell grid gap-14 lg:grid-cols-12 lg:gap-20">
		<div class="lg:col-span-4" data-reveal>
			<div class="rule-spectrum" aria-hidden="true" data-reveal="bar"></div>
			<p class="eyebrow mt-6">Preguntas frecuentes</p>
			<h2 class="mt-4 text-h2">Resolvemos tus dudas</h2>
			<p class="lead mt-5">
				¿No encuentras lo que buscas? Escríbenos y te respondemos personalmente.
			</p>
			<a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-outline mt-7">
				Hablar por WhatsApp
			</a>
		</div>

		<div class="lg:col-span-8" data-reveal>
			{
				FAQ_ITEMS.map((item) => (
					<details class="group border-b border-line first:border-t">
						<summary class="flex cursor-pointer list-none items-start justify-between gap-8 py-6">
							<h3 class="text-[1.0625rem] font-semibold text-fg">{item.question}</h3>
							<Icon
								name="plus"
								class="mt-1 h-5 w-5 flex-none text-brand-600 transition-transform duration-200 group-open:rotate-45"
							/>
						</summary>
						<p class="max-w-2xl pb-6 text-[0.9375rem] leading-relaxed text-fg-muted">
							{item.answer}
						</p>
					</details>
				))
			}
		</div>
	</div>
</section>

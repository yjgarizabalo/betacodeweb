---
/**
 * Conmutador de tema claro/oscuro.
 * El tema se aplica antes del primer pintado mediante el script en línea
 * del Layout, así que aquí solo gestionamos el cambio y la persistencia.
 */
---

<button
	id="theme-toggle"
	type="button"
	class="inline-flex h-11 w-11 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
	aria-label="Cambiar entre tema claro y oscuro"
>
	<!-- Sol: visible en tema oscuro (acción = pasar a claro) -->
	<svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
	</svg>
	<!-- Luna: visible en tema claro (acción = pasar a oscuro) -->
	<svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
	</svg>
</button>

<script>
	function initThemeToggle() {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;

		btn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			} catch {
				/* almacenamiento bloqueado: el tema durará solo esta visita */
			}
		});
	}

	document.addEventListener('astro:page-load', initThemeToggle);
</script>

---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Icon from '@components/Icon.astro';
import BrandIcon from '@components/BrandIcon.astro';
import HeroGlobe from '@components/HeroGlobe.astro';
import { CONTACT, WHATSAPP_URL, LOCATION, SITE } from '@/consts';
---

<Layout
	title={`Contacto | ${SITE.name}`}
	description="Hablemos de tu proyecto. Contáctanos por WhatsApp o correo y recibe una cotización personalizada sin compromiso."
>
	<Header />
	<main>
		<section class="hero-stage">
			<div class="hero-glow" aria-hidden="true"></div>
			<HeroGlobe />

			<div class="hero-content shell pb-16 pt-28 lg:pb-20 lg:pt-32">
				<div class="mx-auto max-w-3xl text-center">
					<p class="badge-hero">
						<span class="h-1.5 w-1.5 rounded-full bg-brand-500 dark:bg-brand-300" aria-hidden="true"></span>
						Contacto
					</p>
					<h1 class="mt-6 text-display">Hablemos de tu proyecto</h1>
					<p class="mx-auto mt-5 max-w-2xl text-lead text-fg-muted">
						Tu idea es nuestra inspiración. Cuéntanos qué necesitas y creemos juntos algo
						extraordinario. Elige el canal que prefieras y te respondemos lo antes posible.
					</p>
				</div>
			</div>
		</section>

		<section class="section bg-surface">
			<div class="shell">
				<div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2">
					<a
						href={WHATSAPP_URL}
						target="_blank"
						rel="noopener"
						class="card card-hover flex flex-col p-8"
					>
						<span class="icon-tile">
							<BrandIcon name="whatsapp" class="h-[1.375rem] w-[1.375rem]" />
						</span>
						<h2 class="mt-6 text-h3">WhatsApp</h2>
						<p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-fg-muted">
							La forma más rápida de contactarnos. Respuesta cercana y directa.
						</p>
						<span class="btn-link mt-6">
							{CONTACT.whatsappDisplay}
							<Icon name="arrow-right" class="h-4 w-4" />
						</span>
					</a>

					<a href={`mailto:${CONTACT.email}`} class="card card-hover flex flex-col p-8">
						<span class="icon-tile">
							<Icon name="envelope" class="h-[1.375rem] w-[1.375rem]" />
						</span>
						<h2 class="mt-6 text-h3">Correo electrónico</h2>
						<p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-fg-muted">
							¿Prefieres escribirnos con calma? Cuéntanos los detalles de tu proyecto.
						</p>
						<span class="btn-link mt-6 break-all">
							{CONTACT.email}
							<Icon name="arrow-right" class="h-4 w-4 flex-none" />
						</span>
					</a>
				</div>

				<p class="mt-10 flex items-center justify-center gap-2 text-[0.9375rem] text-fg-muted">
					<Icon name="map-pin" class="h-[1.125rem] w-[1.125rem] flex-none" />
					Atendemos desde {LOCATION.city}, {LOCATION.country} — para clientes de todo el país y el exterior.
				</p>
			</div>
		</section>
	</main>
</Layout>

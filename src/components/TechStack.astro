---
const techs = ['React', 'Astro', 'Node.js', 'TypeScript', 'Tailwind CSS', 'Python', 'WordPress', 'Docker'];
---

<section class="border-b border-line bg-surface py-12">
	<div class="shell">
		<p data-reveal class="text-center text-[0.8125rem] font-semibold uppercase tracking-[0.08em] text-fg-muted/80">
			Tecnologías con las que trabajamos
		</p>
		<ul data-reveal class="mt-7 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
			{
				techs.map((tech) => (
					<li class="tech-item text-lg font-semibold tracking-tight text-fg-muted/75 hover:text-fg">
						{tech}
					</li>
				))
			}
		</ul>
	</div>
</section>

---
import { Image } from 'astro:assets';
import heroImage from '@assets/about_1.jpg';
import { WHATSAPP_URL } from '@/consts';
import Icon from '@components/Icon.astro';
import HeroGlobe from '@components/HeroGlobe.astro';
---

<section id="inicio" class="hero-stage">
	<div class="hero-glow" aria-hidden="true"></div>
	<HeroGlobe />

	<div class="hero-content shell pb-16 pt-28 lg:pb-20 lg:pt-32">
		<div class="mx-auto max-w-5xl text-center">
			<p class="badge-hero animate-fade-up">
				<span class="h-1.5 w-1.5 rounded-full bg-brand-500 dark:bg-brand-300" aria-hidden="true"></span>
				Agencia digital en Barranquilla
			</p>

			<h1 class="mt-6 text-display animate-fade-up">
				Construimos sitios web que hacen crecer tu negocio
			</h1>

			<p
				class="mx-auto mt-5 max-w-2xl text-lead text-fg-muted animate-fade-up"
				style="animation-delay:.06s"
			>
				Fusionamos creatividad y tecnología para crear sitios web y software que
				destacan visualmente e impulsan tus resultados. Descubre cómo transformar tu
				presencia en línea y potenciar tus metas empresariales.
			</p>

			<div
				class="mt-8 flex flex-wrap items-center justify-center gap-3 animate-fade-up"
				style="animation-delay:.12s"
			>
				<a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-hero">
					<span class="btn-hero-dot">
						<Icon name="arrow-up-right" class="h-[1.125rem] w-[1.125rem]" />
					</span>
					Cotiza tu proyecto
				</a>
				<a href="#servicios" class="btn-hero-ghost">
					Ver servicios
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>

		<div class="mt-12 animate-fade-up" style="animation-delay:.18s">
			<Image
				src={heroImage}
				alt="Equipo de Betacode desarrollando sitios web y software a medida"
				widths={[768, 1136, 1500]}
				sizes="(max-width: 1240px) 92vw, 909px"
				loading="eager"
				fetchpriority="high"
				class="aspect-[16/7] w-full rounded-2xl border border-line object-cover shadow-lift dark:border-white/10"
			/>
		</div>
	</div>
</section>
